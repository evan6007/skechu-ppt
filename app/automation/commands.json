  {
    "name": "trace_image",
    "description": "Start one background tracing job for an existing reference image. Does not apply it. Poll get_task, then explicitly apply_trace. Another trace is rejected until cancelled/applied.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "context": {
          "type": "object",
          "properties": {
            "projectId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "pageId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "revision": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "projectId",
            "pageId",
            "revision"
          ],
          "additionalProperties": false
        },
        "imageId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "mode": {
          "type": "string",
          "enum": [
            "auto",
            "line",
            "contour",
            "photo"
          ]
        },
        "threshold": {
          "type": "number",
          "minimum": 40,
          "maximum": 220
        },
        "accuracy": {
          "type": "number",
          "minimum": 0.3,
          "maximum": 6
        },
        "simplify": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "minLength": {
          "type": "number",
          "minimum": 0,
          "maximum": 30
        }
      },
      "required": [
        "context",
        "imageId"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "idempotentHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "get_task",
